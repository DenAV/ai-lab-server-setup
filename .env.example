# AI Lab Server Setup — Environment Variables
#
# Auto-generate with all secrets:
#   bash scripts/generate-env.sh example.com user@example.com
#
# Or copy and edit manually:
#   cp .env.example .env && nano .env
#
# NEVER commit .env — only .env.example

# =============================================================================
# General
# =============================================================================
DOMAIN=example.com
ACME_EMAIL=user@example.com
TIMEZONE=Europe/Berlin
# Required only with compose.traefik-cloudflare.yml; keep the token outside the repo.
CLOUDFLARE_DNS_API_TOKEN_FILE=

# =============================================================================
# Demo DB — Shared PostgreSQL for demo projects
# =============================================================================
DEMO_DB_PASSWORD=CHANGE-ME-demo-db-password

# =============================================================================
# n8n
# =============================================================================
N8N_VERSION=2.40.7
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE-ME-n8n-password
N8N_ENCRYPTION_KEY=CHANGE-ME-n8n-encryption-key

# =============================================================================
# OpenClaw
# =============================================================================
OPENCLAW_VERSION=2026.9.3
OPENCLAW_GATEWAY_TOKEN=CHANGE-ME-openclaw-gateway-token

# Product profiles are resolved from presets in config/components.yml.
# Set to local-model only when explicitly enabling the optional Ollama container.
COMPOSE_PROFILES=
OLLAMA_VERSION=0.34.0

# =============================================================================
# LiteLLM
# =============================================================================
LITELLM_VERSION=v1.103.2
LITELLM_DB_VERSION=16.15-alpine
LITELLM_SUBDOMAIN=lllm
# Comma-separated trusted ingress CIDRs. Use current Cloudflare edge ranges when proxied.
LITELLM_UI_ALLOWLIST=127.0.0.1/32
# Proxies allowed to supply X-Forwarded-* headers. Use current Cloudflare edge ranges when proxied.
TRAEFIK_FORWARDED_HEADERS_TRUSTED_IPS=127.0.0.1/32
# Traefik only: 1. Cloudflare then Traefik: 2.
LITELLM_MCP_XFF_NUM_TRUSTED_HOPS=1
LITELLM_DB_PASSWORD=CHANGE-ME-litellm-db-password
LITELLM_MASTER_KEY=sk-CHANGE-ME-litellm-master-key
LITELLM_SALT_KEY=sk-CHANGE-ME-litellm-salt-key

# =============================================================================
# Qdrant
# =============================================================================
QDRANT_VERSION=v1.19.1
QDRANT_API_KEY=CHANGE-ME-qdrant-api-key

# =============================================================================
# Langfuse
# =============================================================================
LANGFUSE_VERSION=2
LANGFUSE_SECRET_KEY=CHANGE-ME-langfuse-secret
LANGFUSE_NEXT_AUTH_SECRET=CHANGE-ME-langfuse-auth-secret
LANGFUSE_SALT=CHANGE-ME-langfuse-salt
LANGFUSE_DB_PASSWORD=CHANGE-ME-langfuse-db-password

# =============================================================================
# Traefik
# =============================================================================
TRAEFIK_VERSION=v3.6

# =============================================================================
# Dify
# =============================================================================
DIFY_VERSION=1.13.3
DIFY_SECRET_KEY=CHANGE-ME-dify-secret-key
DIFY_DB_PASSWORD=CHANGE-ME-dify-db-password
DIFY_REDIS_PASSWORD=CHANGE-ME-dify-redis-password
DIFY_SANDBOX_KEY=CHANGE-ME-dify-sandbox-key
DIFY_SANDBOX_VERSION=0.2.14
DIFY_PLUGIN_VERSION=0.5.3-local
DIFY_PLUGIN_DAEMON_KEY=CHANGE-ME-dify-plugin-daemon-key
DIFY_PLUGIN_INNER_API_KEY=CHANGE-ME-dify-plugin-inner-api-key
