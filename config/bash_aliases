# AI Lab shortcuts
alias qdrant-start='docker compose -f ~/ai-lab-server-setup/docker-compose.yml --env-file ~/ai-lab-server-setup/.env --profile qdrant up -d qdrant'
alias qdrant-stop='docker compose -f ~/ai-lab-server-setup/docker-compose.yml --env-file ~/ai-lab-server-setup/.env --profile qdrant stop qdrant'
alias ollama-models='ollama list'
alias lab-validate='~/ai-lab-server-setup/scripts/validate.sh'
